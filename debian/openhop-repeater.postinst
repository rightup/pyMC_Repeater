#!/bin/sh
set -e

if [ "$1" = "configure" ]; then
    # Reject unsafe path shapes before making any privileged package changes.
    for directory in \
        /etc/openhop_repeater \
        /var/lib/openhop_repeater \
        /var/log/openhop_repeater
    do
        if [ -L "$directory" ]; then
            echo "Refusing symlinked openHop directory: $directory" >&2
            exit 1
        fi
    done
    if [ -L /etc/openhop_repeater/config.yaml ]; then
        echo "Refusing symlinked config: /etc/openhop_repeater/config.yaml" >&2
        exit 1
    fi
    if [ -e /etc/openhop_repeater/config.yaml ] \
        && [ ! -f /etc/openhop_repeater/config.yaml ]; then
        echo "Refusing non-regular config: /etc/openhop_repeater/config.yaml" >&2
        exit 1
    fi

    if ! getent group repeater >/dev/null; then
        addgroup --system repeater
    fi

    if ! getent passwd repeater >/dev/null; then
        adduser \
            --system \
            --ingroup repeater \
            --home /var/lib/openhop_repeater \
            --no-create-home \
            --shell /usr/sbin/nologin \
            repeater
    fi

    # Use only hardware-access groups already defined by the target system.
    # This supports serial, USB, SPI, and GPIO installs without inventing host
    # group IDs or granting broader capabilities.
    for hardware_group in dialout plugdev spi gpio
    do
        if getent group "$hardware_group" >/dev/null; then
            adduser repeater "$hardware_group" >/dev/null
        fi
    done

    install -d -o repeater -g repeater -m 0750 \
        /etc/openhop_repeater \
        /var/lib/openhop_repeater \
        /var/log/openhop_repeater

    if [ -L /etc/openhop_repeater/config.yaml ]; then
        echo "Refusing symlinked config: /etc/openhop_repeater/config.yaml" >&2
        exit 1
    elif [ ! -e /etc/openhop_repeater/config.yaml ]; then
        # Run the only write into the service-owned config directory as the
        # service account, so a concurrent path replacement cannot turn this
        # maintainer script into a privileged symlink write.
        runuser \
            --user repeater \
            --group repeater \
            -- \
            /usr/bin/install \
            --mode 0600 \
            /usr/share/openhop-repeater/config.yaml.example \
            /etc/openhop_repeater/config.yaml
    elif [ ! -f /etc/openhop_repeater/config.yaml ]; then
        echo "Refusing non-regular config: /etc/openhop_repeater/config.yaml" >&2
        exit 1
    else
        chown --no-dereference repeater:repeater /etc/openhop_repeater/config.yaml
    fi
fi

#DEBHELPER#

exit 0
